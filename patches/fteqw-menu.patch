diff --git a/engine/client/cl_main.c b/engine/client/cl_main.c
index 74b1256..2a14891 100644
--- a/engine/client/cl_main.c
+++ b/engine/client/cl_main.c
@@ -1833,6 +1833,39 @@ CL_Connect_f
 ================
 */
 void CL_Connect_c(int argn, const char *partial, struct xcommandargcompletioncb_s *ctx);
+#ifdef FTE_TARGET_WEB
+static cvar_t cl_web_connect_host = CVARFD("cl_web_connect_host", "", CVAR_NOTFROMSERVER, "If set, restricts connect/join to ws(s) URLs on this host.");
+static qboolean CL_WebConnectAllowed(const char *server)
+{
+	const char *host = cl_web_connect_host.string;
+	const char *p, *hend, *path;
+
+	if (!host || !*host)
+		return true;	//no restriction configured.
+
+	if (!strncmp(server, "ws://", 5))
+		p = server + 5;
+	else if (!strncmp(server, "wss://", 6))
+		p = server + 6;
+	else
+		return false;
+
+	hend = p;
+	while (*hend && *hend != '/' && *hend != '?' && *hend != '#')
+		hend++;
+
+	if ((size_t)(hend - p) != strlen(host) || Q_strncasecmp(p, host, hend - p))
+		return false;
+
+	path = hend;
+	if (*path != '/')
+		return false;
+	if (strncmp(path, "/nq", 3))
+		return false;
+
+	return true;
+}
+#endif
 static void CL_Connect_f (void)
 {
 	char	*server;
@@ -1844,6 +1877,14 @@ static void CL_Connect_f (void)
 	}
 
 	server = Cmd_Argv (1);
+#ifdef FTE_TARGET_WEB
+	if (!CL_WebConnectAllowed(server))
+	{
+		Con_Printf(CON_ERROR"connect is restricted in this build. Use the server list.\n");
+		Cbuf_AddText("menu_slist\n", RESTRICT_LOCAL);
+		return;
+	}
+#endif
 	server = strcpy(alloca(strlen(server)+1), server);
 
 /*#ifdef HAVE_SERVER
@@ -1911,6 +1952,14 @@ static void CL_Join_f (void)
 	}
 
 	server = Cmd_Argv (1);
+#ifdef FTE_TARGET_WEB
+	if (!CL_WebConnectAllowed(server))
+	{
+		Con_Printf(CON_ERROR"join is restricted in this build. Use the server list.\n");
+		Cbuf_AddText("menu_slist\n", RESTRICT_LOCAL);
+		return;
+	}
+#endif
 	server = strcpy(alloca(strlen(server)+1), server);
 
 	CL_Disconnect_f ();
